              ROLLBACK WORK.
            ENDIF.

          ELSE.

            "--Implement process to change only status--"
            CLEAR lv_ecn.
            lv_ecn = ls_out-aennr.
            lv_cmd_flag = abap_true.
            PERFORM update_bom_status USING ls_out-matnr
