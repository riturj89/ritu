                                            lv_ecn
                                            ls_out-posnr
                                            ls_out-datuv
                                            lv_cmd_flag.

            IF sy-subrc = 0.
              " DELETE the processed record from internal table (since status changed to 04)
              DELETE it_out WHERE matnr = |{ ls_out-matnr ALPHA = OUT }|
                            AND werks = ls_out-werks
                            AND idnrk = ls_out-idnrk
                            AND stlst = '04'.

              lv_success_count = lv_success_count + 1.
              COMMIT WORK.
            ELSE.
              lv_error_count = lv_error_count + 1.
              ROLLBACK WORK.
            ENDIF.

          ELSEIF ls_out-stlst = '03'." AND ls_out-aennr IS NOT INITIAL.

            CLEAR lv_ecn.
            lv_ecn = ls_out-aennr.
            CLEAR lv_cmd_flag.
            lv_cmd_flag = abap_false.
            PERFORM update_bom_status USING ls_out-matnr
                                            ls_out-werks
                                            ls_out-idnrk
                                            ls_out-stlst
                                            lv_ecn
                                            ls_out-posnr
                                            ls_out-datuv
                                            lv_cmd_flag.

            IF sy-subrc = 0.
              " DELETE the processed record from internal table (since status changed to 04)
              DELETE it_out WHERE matnr = |{ ls_out-matnr ALPHA = OUT }|
                            AND werks = ls_out-werks
                            AND idnrk = ls_out-idnrk
                            AND stlst = '03'.

              lv_success_count = lv_success_count + 1.
              COMMIT WORK.
            ELSE.
              lv_error_count = lv_error_count + 1.
              ROLLBACK WORK.
            ENDIF.

          ELSEIF ls_out-stlst = '02'." AND ls_out-aennr IS NOT INITIAL.

            CLEAR lv_ecn.
            lv_ecn = ls_out-aennr.
            CLEAR lv_cmd_flag.
            lv_cmd_flag = abap_false.
            PERFORM update_bom_status USING ls_out-matnr
                                            ls_out-werks
                                            ls_out-idnrk
                                            ls_out-stlst
                                            lv_ecn
                                            ls_out-posnr
                                            ls_out-datuv
                                            lv_cmd_flag.

            IF sy-subrc = 0.
              " DELETE the processed record from internal table (since status changed to 04)
              DELETE it_out WHERE matnr = |{ ls_out-matnr ALPHA = OUT }|
                            AND werks = ls_out-werks
                            AND idnrk = ls_out-idnrk
                            AND stlst = '02'.

              lv_success_count = lv_success_count + 1.
              COMMIT WORK.
            ELSE.
              lv_error_count = lv_error_count + 1.
              ROLLBACK WORK.
            ENDIF.

          ELSEIF ls_out-stlst = '01'." AND ls_out-aennr IS NOT INITIAL.

            CLEAR lv_ecn.
            lv_ecn = ls_out-aennr.
            CLEAR lv_cmd_flag.
            lv_cmd_flag = abap_false.
            PERFORM update_bom_status USING ls_out-matnr
                                            ls_out-werks
                                            ls_out-idnrk
                                            ls_out-stlst
                                            lv_ecn
                                            ls_out-posnr
                                            ls_out-datuv
                                            lv_cmd_flag.

            IF sy-subrc = 0.
              " DELETE the processed record from internal table (since status changed to 04)
              DELETE it_out WHERE matnr = |{ ls_out-matnr ALPHA = OUT }|
                            AND werks = ls_out-werks
                            AND idnrk = ls_out-idnrk
                            AND stlst = '01'.

              lv_success_count = lv_success_count + 1.
              COMMIT WORK.
            ELSE.
              lv_error_count = lv_error_count + 1.
              ROLLBACK WORK.
            ENDIF.

          ELSE.

            " Skip if no quantity change
            lv_error_count = lv_error_count + 1.
            MESSAGE 'No quantity change for material' && |{ ls_out-matnr ALPHA = OUT }| TYPE 'S' DISPLAY LIKE 'W'.
          ENDIF.

        ENDLOOP.

        IF lr_grid IS BOUND.
