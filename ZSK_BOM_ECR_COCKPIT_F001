*&---------------------------------------------------------------------*
*& Include          ZSK_BOM_ECR_COCKPIT_F001
*&---------------------------------------------------------------------*
*&---------------------------------------------------------------------*
*& Form GET_DATA
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
FORM get_data USING cv_status TYPE stlst
                    cv_alt_status TYPE stlal.
*                    vt_plant TYPE ty_vt_plant.
  BREAK 20002966.
  DATA: lt_style TYPE lvc_t_styl,
        ls_style TYPE lvc_s_styl.

  REFRESH: it_out.

  IF cv_status = '05'.
    SELECT a~matnr,
           a~werks,
           b~stlnr,
           b~stlst,
           b~bmeng,
           b~labor,
           c~meins,
           c~idnrk,
           c~menge AS old_menge,
           c~aennr,
           c~andat,
           c~annam,
           c~posnr,
           c~aedat,
           c~aenam,
           c~datuv,
           m1~maktx AS maktx,
           m2~maktx AS maktx1,
           d~lbtxt
      FROM mast AS a
      INNER JOIN stko AS b ON a~stlnr = b~stlnr
      INNER JOIN stpo AS c ON b~stlnr = c~stlnr
      INNER JOIN makt AS m1 ON m1~matnr = a~matnr AND m1~spras = @sy-langu
      INNER JOIN makt AS m2 ON m2~matnr = c~idnrk AND m2~spras = @sy-langu
      INNER JOIN t024x AS d ON d~labor = b~labor AND d~spras = @sy-langu
      WHERE a~werks IN @s_werks "a~matnr IN @s_matnr
        AND a~matnr IN @s_matnr "a~werks IN @s_werks
        AND c~idnrk IN @s_idnrk
        AND b~andat <= @s_date-low
        AND b~labor = @p_labor
    AND b~stlst = @cv_status
    AND b~stlal = @cv_alt_status
    AND c~lkenz = @space
    " Get the latest BOM version
    AND b~stkoz = ( SELECT MAX( stkoz ) FROM stko AS b2 WHERE b2~stlnr = b~stlnr AND b2~stlty = b~stlty AND b2~stlal = b~stlal )
    " Validity date check on STKO header (VALID_TO)
    AND b~datuv <= @s_date-low
    AND ( b~valid_to >= @s_date-high OR b~valid_to <= '00000000' ) INTO CORRESPONDING FIELDS OF TABLE @it_out.


  ELSE.
    " Your original SELECT for other statuses (without the MAX STKOZ logic)
    SELECT a~matnr,
           a~werks,
           b~stlnr,
           b~stlst,
           b~bmeng,
           b~labor,
           c~meins,
           c~idnrk,
           c~menge AS old_menge,
           c~aennr,
           c~andat,
           c~annam,
           c~posnr,
           c~aedat,
           c~aenam,
           c~datuv,
           m1~maktx AS maktx,
           m2~maktx AS maktx1,
           d~lbtxt
      FROM mast AS a
      INNER JOIN stko AS b ON a~stlnr = b~stlnr
      INNER JOIN stpo AS c ON b~stlnr = c~stlnr
      INNER JOIN makt AS m1 ON m1~matnr = a~matnr AND m1~spras = @sy-langu
      INNER JOIN makt AS m2 ON m2~matnr = c~idnrk AND m2~spras = @sy-langu
      INNER JOIN t024x AS d ON d~labor = b~labor AND d~spras = @sy-langu
      WHERE a~werks IN @s_werks
        AND a~matnr IN @s_matnr
        AND c~idnrk IN @s_idnrk
        AND b~andat <= @s_date-low
        AND b~labor = @p_labor
        AND b~stlst = @cv_status
        AND b~stlal = @cv_alt_status
        AND c~lkenz = @space
*        AND c~stpoz = ( SELECT MAX( stpoz ) FROM stpo AS c2 WHERE c2~stlnr = c~stlnr AND c2~posnr = c~posnr )
      AND b~stkoz = ( SELECT MAX( stkoz ) FROM stko AS b2 WHERE b2~stlnr = b~stlnr AND b2~stlty = b~stlty AND b2~stlal = b~stlal )
        AND b~datuv <= @s_date-low
        AND ( b~valid_to >= @s_date-high OR b~valid_to <= '00000000' ) INTO CORRESPONDING FIELDS OF TABLE @it_out.
  ENDIF.

  IF sy-subrc <> 0.
    MESSAGE |No items found with Status { cv_status } | TYPE 'S' DISPLAY LIKE 'E'.
  ELSE.
    BREAK 20002966.
    SORT it_out BY matnr werks posnr idnrk old_menge.
    DELETE ADJACENT DUPLICATES FROM it_out COMPARING matnr werks posnr idnrk old_menge.

    " Initialize NEW_MENGE with OLD_MENGE value
    DATA: lv_valid TYPE datuv_bi.
    LOOP AT it_out ASSIGNING FIELD-SYMBOL(<fs_out>).
      <fs_out>-matnr = |{ <fs_out>-matnr ALPHA = OUT }|.
      <fs_out>-idnrk = |{ <fs_out>-idnrk ALPHA = OUT }|.
      <fs_out>-new_menge = <fs_out>-old_menge.
      " --- Handle Row Level Editing ---
      REFRESH <fs_out>-cell_style.
      IF <fs_out>-stlst <> '5' AND <fs_out>-stlst <> '05'.
        ls_style-fieldname = 'NEW_MENGE'.
        ls_style-style     = cl_gui_alv_grid=>mc_style_disabled.
        INSERT ls_style INTO TABLE <fs_out>-cell_style.
      ENDIF.
    ENDLOOP.


    FIELD-SYMBOLS: <fs_out1> LIKE LINE OF it_out.

    LOOP AT it_out ASSIGNING <fs_out1>.
      " This populates the paperclip symbol in the column row
*      <fs_out1>-attach = icon_attachment. " Ensure <icon> pool is declared (INCLUDE <icon>)


      SELECT SINGLE stlnr FROM zecr_attach_bom
    WHERE stlnr = @<fs_out1>-stlnr
    INTO @DATA(lv_exists).

      IF sy-subrc = 0.
        <fs_out1>-attach = icon_attachment. " Bright icon (File exists)
      ELSE.
        <fs_out1>-attach = icon_create. " Empty/New icon (No file yet)
      ENDIF.

    ENDLOOP.

  ENDIF.


ENDFORM.
