*&---------------------------------------------------------------------*
*& Form USER_COMMAND
*&---------------------------------------------------------------------*
FORM user_command USING r_ucomm LIKE sy-ucomm
                        rs_selfield TYPE slis_selfield.

  DATA: lv_ecn TYPE aennr.
  DATA: lr_grid TYPE REF TO cl_gui_alv_grid.
  DATA: ls_out LIKE LINE OF it_out.
  DATA: lv_valid TYPE flag.
  DATA: lv_success_count TYPE i.
  DATA: lv_error_count TYPE i.
  DATA: lv_message TYPE string.
  DATA: lv_description TYPE string.
  DATA: lv_old_menge_str TYPE string.
  DATA: lv_new_menge_str TYPE string.
  DATA: lv_bmeng_str TYPE string.
  DATA: lv_cmd_flag TYPE abap_bool.

  DATA: lv_filename TYPE string,
        lv_filepath TYPE string,
        lv_file_len TYPE i,
        lt_bin_data TYPE STANDARD TABLE OF raw256,
        lv_xstring  TYPE xstring,
        lt_file_tab TYPE filetable,
        lv_rc       TYPE i,
        lv_ans      TYPE char1.


  CALL FUNCTION 'GET_GLOBALS_FROM_SLVC_FULLSCR'
    IMPORTING
      e_grid = lr_grid.

  CASE r_ucomm.

    WHEN '&NTE' OR 'REFRESH'. " Refresh Icon Clicked
      PERFORM get_data USING p_status p_stlal.
      rs_selfield-refresh    = 'X'.
      rs_selfield-row_stable = 'X'.

      IF lr_grid IS BOUND.
        CALL METHOD lr_grid->refresh_table_display.
      ENDIF.



    WHEN 'SL' OR 'SELECT_ALL'.
      " Select all rows
      LOOP AT it_out INTO ls_out.
        ls_out-sel = 'X'.
        MODIFY it_out FROM ls_out INDEX sy-tabix.
      ENDLOOP.

      " Refresh ALV display
      IF lr_grid IS BOUND.
        CALL METHOD lr_grid->refresh_table_display.
      ENDIF.

    WHEN 'DL' OR 'DESELECT_ALL'.
      " Deselect all rows
      LOOP AT it_out INTO ls_out.
        CLEAR ls_out-sel.
        MODIFY it_out FROM ls_out INDEX sy-tabix.
      ENDLOOP.

      " Refresh ALV display
      IF lr_grid IS BOUND.
        CALL METHOD lr_grid->refresh_table_display.
      ENDIF.

      " Standard code triggered when hotspot column is clicked
    WHEN '&IC1'.
      IF rs_selfield-fieldname = 'ATTACH'.

        " -------------------------------------------------------------
        "Force ALV to capture checked boxes/cell inputs from screen
        " -------------------------------------------------------------
        IF lr_grid IS NOT BOUND.
          CALL FUNCTION 'GET_GLOBALS_FROM_SLVC_FULLSCR'
            IMPORTING
              e_grid = lr_grid.
        ENDIF.
*
        IF lr_grid IS BOUND.
          CALL METHOD lr_grid->check_changed_data.
        ENDIF.
*        " -------------------------------------------------------------

        READ TABLE it_out ASSIGNING FIELD-SYMBOL(<fs_row>) INDEX rs_selfield-tabindex.
        IF sy-subrc = 0.

          " Check if an attachment exists for this specific BOM (stlnr)
          SELECT * FROM zecr_attach_bom WHERE stlnr = @<fs_row>-stlnr ORDER BY zseq_no DESCENDING INTO TABLE @DATA(lt_attachments) UP TO 1 ROWS.

          IF sy-subrc = 0.
            " ---------------------------------------------------------
            " FILE EXISTS: Prompt the user to either View or Upload new version
            " ---------------------------------------------------------
            READ TABLE lt_attachments INTO DATA(ls_current_attach) INDEX 1.

            CALL FUNCTION 'POPUP_TO_CONFIRM'
              EXPORTING
                titlebar              = 'Attachment Detected'
                text_question         = 'An attachment already exists. Do you want to VIEW it? (Choose No to upload a new version instead)'
                text_button_1         = 'View'
                text_button_2         = 'Upload New'
                display_cancel_button = 'X'
              IMPORTING
                answer                = lv_ans
              EXCEPTIONS
                OTHERS                = 1.

            BREAK 20002966.
            IF lv_ans = '1'. " VIEW MODE
              lv_xstring  = ls_current_attach-file_content.
              lv_file_len = ls_current_attach-file_length.
              lv_filename = ls_current_attach-filename.

              " Transform raw database binary string back to application file layout
              CALL FUNCTION 'SCMS_XSTRING_TO_BINARY'
                EXPORTING
                  buffer        = lv_xstring
                IMPORTING
                  output_length = lv_file_len
                TABLES
                  binary_tab    = lt_bin_data.

              CLEAR lv_filepath.

              cl_gui_frontend_services=>get_temp_directory(
                CHANGING
                  temp_dir             =  lv_filepath     " Temporary Directory
                EXCEPTIONS
                  cntl_error           = 1                " Control error
                  error_no_gui         = 2                " No GUI available
                  not_supported_by_gui = 3                " GUI does not support this
                  OTHERS               = 4 ).

              CALL METHOD cl_gui_cfw=>flush
                EXCEPTIONS
                  cntl_system_error = 1
                  cntl_error        = 2
                  OTHERS            = 3.

              "EMERGENCY BACKUP: If it's still initial despite subrc 0, assign a backup track
              IF sy-subrc <> 0 OR lv_filepath IS INITIAL.
                lv_filepath = 'C:\TEMP'.
              ELSE.
                CONDENSE lv_filepath NO-GAPS.
              ENDIF.
*
*              IF sy-subrc <> 0 OR lv_filepath IS INITIAL.
*                lv_filepath = 'C:\Users\ritur\AppData\Local\SAP\SAP GUI\tmp\'.
*              ELSE.
*
*                CONDENSE lv_filepath NO-GAPS.
*              ENDIF.

              CONDENSE lv_filename NO-GAPS.
*              CONCATENATE lv_filepath '\' lv_filename INTO lv_filepath.
              lv_filepath = |{ lv_filepath }\\{ lv_filename }|.

              " Download file locally to temp
              cl_gui_frontend_services=>gui_download(
              EXPORTING
                bin_filesize = lv_file_len
                filename     = lv_filepath
                filetype     = 'BIN'
                CHANGING
                  data_tab     = lt_bin_data
                  EXCEPTIONS
                    OTHERS       = 1 ).

              IF sy-subrc = 0." Open native PC application layout (PDF Viewer, Excel, etc.)
                cl_gui_frontend_services=>execute( EXPORTING document = lv_filepath EXCEPTIONS OTHERS = 1 ).
              ENDIF.
              RETURN.
            ELSEIF lv_ans <> '2'. " User Cancelled
              RETURN.
            ENDIF.
          ENDIF.


          cl_gui_frontend_services=>file_open_dialog(
          EXPORTING window_title = 'Select Document to Link to BOM'
          CHANGING
            file_table   = lt_file_tab
            rc           = lv_rc
            EXCEPTIONS
              OTHERS       = 1 ).

          IF sy-subrc = 0 AND lv_rc > 0.
            READ TABLE lt_file_tab INTO DATA(ls_selected_file) INDEX 1.
            lv_filepath = ls_selected_file-filename.

            " Isolate filename from root pathway location
            CALL FUNCTION 'SO_SPLIT_FILE_AND_PATH'
              EXPORTING
                full_name     = lv_filepath
              IMPORTING
                stripped_name = lv_filename.

            " Upload binary components into internal SAP memory
            cl_gui_frontend_services=>gui_upload(
            EXPORTING filename   = lv_filepath
              filetype   = 'BIN'
              IMPORTING
                filelength = lv_file_len
                CHANGING
                  data_tab   = lt_bin_data
                  EXCEPTIONS
                    OTHERS     = 1 ).

            IF sy-subrc = 0.

              CALL FUNCTION 'SCMS_BINARY_TO_XSTRING'
                EXPORTING
                  input_length = lv_file_len
                IMPORTING
                  buffer       = lv_xstring
                TABLES
                  binary_tab   = lt_bin_data.

              " Calculate next safe sequential index number for this BOM
              SELECT MAX( zseq_no ) FROM zecr_attach_bom WHERE stlnr = @<fs_row>-stlnr
                INTO @DATA(lv_max_seq).

              DATA(lv_next_seq) = lv_max_seq + 1.
              " Populate and submit to custom table layout structure
              DATA: ls_db_insert TYPE zecr_attach_bom.
              ls_db_insert-stlnr        = <fs_row>-stlnr.
              ls_db_insert-zseq_no      = lv_next_seq.
              ls_db_insert-filename     = lv_filename.
              ls_db_insert-file_length  = lv_file_len.
              ls_db_insert-file_content = lv_xstring.
              ls_db_insert-uname        = sy-uname.
              ls_db_insert-aedat        = sy-datum.
              INSERT zecr_attach_bom FROM @ls_db_insert.
              IF sy-subrc = 0.
                <fs_row>-attach = icon_attachment. " Toggle display clip to green immediately


*                rs_selfield-refresh    = 'X'. " Re-render the grid layout
*                rs_selfield-row_stable = 'X'. " Keep scroll position
*                rs_selfield-col_stable = 'X'. " Keep column position
*
*                " 4. MODIFY THE INTERNAL OUTPUT POINTER DIRECTLY
*                " This forces the specific line index to commit its memory layout
*                MODIFY it_out FROM <fs_row> INDEX rs_selfield-tabindex.





                MESSAGE 'Document version successfully saved to database.' TYPE 'S'.
              ELSE.
                MESSAGE 'Database transaction failed.' TYPE 'E'.
              ENDIF.
            ENDIF.
          ENDIF.
        ENDIF.
      ENDIF.


    WHEN 'SUBMIT'.
      CLEAR lv_cmd_flag.


      " Force ALV to pass UI changes to internal table
      IF lr_grid IS BOUND.
        CALL METHOD lr_grid->check_changed_data
          IMPORTING
            e_valid = lv_valid.
      ENDIF.

      IF lv_valid = abap_true.
        " Process each selected item
        LOOP AT it_out INTO ls_out WHERE sel = 'X'.
          BREAK 20002966.
          " Check if NEW_MENGE is entered and different from OLD_MENGE
          IF ls_out-new_menge IS NOT INITIAL AND
             ls_out-new_menge <> ls_out-old_menge AND ls_out-stlst = '05'.

            lv_cmd_flag = abap_true.

            IF ls_out-reasone IS NOT INITIAL.
              " Convert numeric fields to strings for description
              lv_old_menge_str = ls_out-old_menge.
              lv_new_menge_str = ls_out-new_menge.
              lv_bmeng_str     = ls_out-bmeng.

              " Create description for ECN using string concatenation
*              CONCATENATE 'BOM Qty Change for' ls_out-matnr
*                          'Component' ls_out-idnrk
*                          'from' lv_old_menge_str
*                          'to' lv_new_menge_str
*                          'Base Qty' lv_bmeng_str
*                          INTO lv_description SEPARATED BY space.

              DATA:lv_mat1 TYPE matnr.

              CALL FUNCTION 'CONVERSION_EXIT_MATN1_OUTPUT'
                EXPORTING
                  input  = ls_out-matnr
                IMPORTING
                  output = lv_mat1.


              lv_description = |Qty.Change/{ lv_mat1 }/{ lv_new_menge_str } to { lv_new_menge_str }|.



              " Generate ECN number using standard function
              CLEAR lv_ecn.
              IF ls_out-aennr IS INITIAL.
                PERFORM generate_ecn_number_standard USING lv_description ls_out-reasone CHANGING lv_ecn.
              ELSE.
                lv_ecn = ls_out-aennr.
              ENDIF.

              IF lv_ecn IS NOT INITIAL.
                " Update BOM with new quantity and change status
                ls_out-matnr = |{ ls_out-matnr ALPHA = IN WIDTH = 18 }|.
                ls_out-idnrk = |{ ls_out-idnrk ALPHA = IN WIDTH = 18 }|.

                PERFORM update_bom_quantity
                        USING ls_out-matnr
                              ls_out-werks
                              ls_out-idnrk
                              ls_out-old_menge
                              ls_out-new_menge
                              lv_ecn
                              ls_out-stlst
                              ls_out-posnr
                              ls_out-datuv
                              lv_description.

                IF sy-subrc = 0.
                  lv_success_count = lv_success_count + 1.
                  DATA: iv_index TYPE sy-tabix.
                  LOOP AT it_out INTO ls_out WHERE idnrk = ls_out-idnrk.

                    iv_index = sy-tabix.
                    ls_out-stlst = '04'.
                    ls_out-aedat = sy-datum.
                    ls_out-aenam = sy-uname.
                    ls_out-aennr = lv_ecn.
                    ls_out-reasone = lv_description.
                    MODIFY it_out INDEX iv_index FROM ls_out.
                    EXIT.
                  ENDLOOP.

                  " DELETE the processed record from internal table (since status changed to 04)
                  ls_out-matnr = |{ ls_out-matnr ALPHA = OUT }|.
                  DELETE it_out WHERE matnr = ls_out-matnr
                                AND werks = ls_out-werks
                                AND idnrk = ls_out-idnrk
                                AND posnr = ls_out-posnr
                                AND stlst = ls_out-stlst - 1.

                  COMMIT WORK.
                ELSE.
                  lv_error_count = lv_error_count + 1.
                  ROLLBACK WORK.
                  MESSAGE 'No quantity change for material' && |{ ls_out-matnr ALPHA = OUT }| TYPE 'S' DISPLAY LIKE 'W'.
                ENDIF.
              ENDIF.
            ELSE.
              MESSAGE 'Reasone of change is not specified' TYPE 'E'.
            ENDIF.

          ELSEIF ( ls_out-stlst = '04' OR ls_out-stlst = '03' OR ls_out-stlst = '02' )."  AND ls_out-aennr IS NOT INITIAL.

            CLEAR lv_ecn.
            lv_ecn = ls_out-aennr.

            lv_cmd_flag = abap_true.

            PERFORM update_bom_status USING ls_out-matnr
                                            ls_out-werks
                                            ls_out-idnrk
                                            ls_out-stlst
                                            lv_ecn
                                            ls_out-posnr
                                            ls_out-datuv
                                            lv_cmd_flag.
*                                            lv_flag.

            IF sy-subrc = 0.
              lv_success_count = lv_success_count + 1.

              DATA: v_index TYPE sy-tabix.
              LOOP AT it_out INTO ls_out WHERE idnrk = ls_out-idnrk.

                v_index = sy-tabix.
                ls_out-stlst = ls_out-stlst - 1.
                ls_out-aedat = sy-datum.
                ls_out-aenam = sy-uname.
                MODIFY it_out INDEX v_index FROM ls_out.
                EXIT.
              ENDLOOP.

              " DELETE the processed record from internal table (since status changed to 04)
              DELETE it_out WHERE matnr = |{ ls_out-matnr ALPHA = OUT }|
                            AND werks = ls_out-werks
                            AND idnrk = ls_out-idnrk
                            AND stlst = ls_out-stlst - 1.


              COMMIT WORK.
            ELSE.
