*&---------------------------------------------------------------------*
*& Form GENERATE_ECN_NUMBER_STANDARD
*&---------------------------------------------------------------------*
FORM generate_ecn_number_standard  USING    p_description TYPE string
                                            p_reasone TYPE char40
                                    CHANGING p_ecn TYPE aennr.


  DATA: ls_header     TYPE aenr_api01,
        ls_object_bom TYPE aenv_api01,
        lv_change_no  TYPE aennr.

  " Clear structures
  CLEAR: ls_header, ls_object_bom.

  " Prepare ECN Header
  ls_header-change_no  = ''.                      " Leave empty for auto-generation
  ls_header-descript   = p_description(40).       " Description (max 40 chars)

  DATA: lv_external_date(10) TYPE c.


  CALL FUNCTION 'CONVERT_DATE_TO_EXTERNAL'
    EXPORTING
      date_internal            = sy-datum
    IMPORTING
      date_external            = lv_external_date
    EXCEPTIONS
      date_internal_is_invalid = 1
      OTHERS                   = 2.

  ls_header-valid_from = lv_external_date.


  ls_header-status     = '01'.                                 " Status: 01 = Created
  ls_header-reason_chg = p_reasone.  "'BOM Qty Update'.        " Reason for change

  " Prepare BOM Object (REQUIRED)
  ls_object_bom-active     = 'X'.                 " Activate BOM as affected object
  ls_object_bom-obj_requ   = 'X'.                 " Object required
  ls_object_bom-mgtrec_gen = 'X'.                 " Generate management record


  " Call the function module
  CALL FUNCTION 'CCAP_ECN_CREATE'
    EXPORTING
      change_header            = ls_header
      object_bom               = ls_object_bom
    IMPORTING
      change_no                = lv_change_no
    EXCEPTIONS
      change_no_already_exists = 1
      error                    = 2
      OTHERS                   = 3.

  IF sy-subrc = 0.
    p_ecn = lv_change_no.
    MESSAGE 'ECN created successfully:' && p_ecn TYPE 'S'.
  ELSE.
    CLEAR p_ecn.
    MESSAGE 'Failed to create ECN. Error:' && sy-subrc TYPE 'S' DISPLAY LIKE 'E'.
  ENDIF.

ENDFORM.
FORM update_bom_quantity  USING    p_matnr TYPE matnr
                                   p_werks TYPE werks_d
                                   p_idnrk TYPE idnrk
                                   p_old_menge TYPE menge_d
                                   p_new_menge TYPE menge_d
                                   p_ecn TYPE aennr
                                   p_stlst TYPE stlst
                                   p_posnr TYPE sposn
                                   p_datuv TYPE datuv
                                   p_reasone TYPE string.

  DATA: lv_fl_warning TYPE c,
        lv_index      TYPE sy-tabix,
        lv_found      TYPE c.

  DATA:t_stpo TYPE TABLE OF  stpo_api02,
       s_stpo TYPE stpo_api02,
       t_stko TYPE TABLE OF  stko_api02,
       s_stko TYPE stko_api02.

  DATA: lt_stpo TYPE TABLE OF stpo_api03,
        ls_stop TYPE stpo_api03.



  DATA: lv_alternative TYPE stalt.  " BOM alternative
  DATA: lv_external(10) TYPE c.

*  BREAK 20002966.
  lv_alternative = p_stlal.

  " 1. OPEN the BOM for reading/modification
  CALL FUNCTION 'CONVERT_DATE_TO_EXTERNAL'
    EXPORTING
      date_internal            = p_datuv "sy-datum
    IMPORTING
      date_external            = lv_external
    EXCEPTIONS
      date_internal_is_invalid = 1
      OTHERS                   = 2.

  " 2. READ the current BOM components

  CALL FUNCTION 'CSAP_MAT_BOM_READ'
    EXPORTING
      material    = p_matnr
      plant       = p_werks
      bom_usage   = '1'
      alternative = lv_alternative
      valid_from  = lv_external
    TABLES
      t_stpo      = lt_stpo
      t_stko      = t_stko
    EXCEPTIONS
      error       = 1
      OTHERS      = 2.

  IF sy-subrc <> 0.
    MESSAGE 'BOM read failed' TYPE 'E'.
    EXIT.
  ELSE.
    lv_found = 'X'.
  ENDIF.

  p_idnrk = |{ p_idnrk ALPHA = OUT }|.
*  LOOP AT lt_stpo INTO ls_stop WHERE component = p_idnrk.
  LOOP AT lt_stpo INTO ls_stop WHERE component = p_idnrk AND item_categ = 'L' AND item_no = p_posnr.
    DATA: iv_exte_date(10) TYPE c.
    CALL FUNCTION 'CONVERT_DATE_TO_EXTERNAL'
      EXPORTING
        date_internal            = sy-datum
      IMPORTING
        date_external            = iv_exte_date
      EXCEPTIONS
        date_internal_is_invalid = 1
        OTHERS                   = 2.

    lv_index = sy-tabix.
    ls_stop-comp_qty   = p_new_menge.
    ls_stop-change_no  = p_ecn.
    ls_stop-changed_on = iv_exte_date.
    ls_stop-changed_by = sy-uname.
    ls_stop-valid_from = lv_external.
    ls_stop-item_text1 = p_reasone(40).
    MODIFY lt_stpo  FROM ls_stop INDEX lv_index.
    EXIT.
  ENDLOOP.

  IF lv_found IS INITIAL.
    MESSAGE 'Component not found in BOM' TYPE 'W'.
    EXIT.
  ENDIF.

  DATA: ls_stko       TYPE stko_api01.
  READ TABLE t_stko INTO ls_stko  INDEX 1.
  IF sy-subrc = 0 AND ls_stko-bom_status > 1.
    ls_stko-bom_status = ls_stko-bom_status - 1.
    MODIFY t_stko FROM ls_stko INDEX 1.

  ENDIF.
  " 4. MAINTAIN the BOM with changed components

  AUTHORITY-CHECK OBJECT 'C_STUE_NOH'
           ID 'NOHIS' FIELD 'X'.

  IF sy-subrc <> 0.
    MESSAGE 'You are not authorized to change this BOM without a Change Number' TYPE 'E'.
  ELSE.
    " Perform the BOM update without an ECN
  ENDIF.


  CALL FUNCTION 'CSAP_MAT_BOM_MAINTAIN'
    EXPORTING
      material           = p_matnr
      plant              = p_werks
      bom_usage          = '1'
      alternative        = lv_alternative
      valid_from         = lv_external
      change_no          = p_ecn
      i_stko             = ls_stko
      fl_commit_and_wait = 'X'
      fl_default_values  = 'X'
      fl_bom_create      = space
    TABLES
      t_stpo             = lt_stpo
    EXCEPTIONS
      error              = 1
      OTHERS             = 2.

  IF sy-subrc <> 0.

    DATA: lv_msg TYPE string.

    CALL FUNCTION 'FORMAT_MESSAGE'
      EXPORTING
        id     = sy-msgid
        lang   = sy-langu
        no     = sy-msgno
        v1     = sy-msgv1
        v2     = sy-msgv2
        v3     = sy-msgv3
        v4     = sy-msgv4
      IMPORTING
        msg    = lv_msg
      EXCEPTIONS
        OTHERS = 0.
    MESSAGE lv_msg TYPE 'E'.
    ROLLBACK WORK.
    EXIT.
  ELSE.
    COMMIT WORK.
    MESSAGE 'BOM quantity updated successfully' TYPE 'S'.
  ENDIF.

*  ENDIF.

ENDFORM.

*&---------------------------------------------------------------------*
*& Form ADD_FIELD_CAT - Enhanced version
*&---------------------------------------------------------------------*
FORM add_field_cat USING VALUE(p_fieldname)
                         VALUE(p_seltext)
                         VALUE(p_editable)
                         VALUE(p_hotspot)
                         VALUE(p_outputlen)
                         VALUE(p_datatype)
                         VALUE(p_decimals).


  DATA: lv_pos TYPE i.
  STATICS: lv_counter TYPE i.

  lv_counter = lv_counter + 1.
  lv_pos = lv_counter.

  CLEAR wa_fc.
  wa_fc-fieldname = p_fieldname.
  wa_fc-scrtext_l = p_seltext.
  wa_fc-scrtext_m = p_seltext.
  wa_fc-scrtext_s = p_seltext.
  wa_fc-reptext   = p_seltext.
  wa_fc-col_pos   = lv_pos.
  wa_fc-hotspot   = p_hotspot.

  wa_fc-col_opt = 'X'.

  " Set output length for decimal fields
  IF p_outputlen IS NOT INITIAL.
    wa_fc-outputlen = p_outputlen.
*  ELSE.
*    wa_fc-outputlen = 17.
  ENDIF.

  IF p_fieldname = 'ATTACH'.
    wa_fc-icon = 'X'. " Force ALV grid to process it visually as a graphic
  ENDIF.


  " Set data type for proper formatting
  IF p_datatype IS NOT INITIAL.
    wa_fc-datatype = p_datatype.
  ENDIF.
  IF p_fieldname = 'OLD_MENGE' OR p_fieldname = 'NEW_MENGE' OR p_fieldname = 'BMENG'.
    wa_fc-datatype = 'QUAN'.
    wa_fc-ref_table = 'STPO'.      " Reference table
    wa_fc-ref_field = 'MENGE'.     " Reference field for unit
    " If decimals is passed separately
    IF p_decimals IS NOT INITIAL.
      wa_fc-decimals_o = p_decimals.
    ENDIF.
  ENDIF.

  " Set edit flag
  IF p_editable = 'X'.
    wa_fc-edit = 'X'.
  ELSE.
    wa_fc-edit = ''.
  ENDIF.

  " Set checkbox for selection field
  IF p_fieldname = 'SEL'.
    wa_fc-checkbox = 'X'.
    wa_fc-edit = 'X'.           " Checkbox must be editable
  ENDIF.

  APPEND wa_fc TO lt_filcat.
  CLEAR wa_fc.

ENDFORM.
*&---------------------------------------------------------------------*
*& Form UPDATE_BOM_STATUS
*&---------------------------------------------------------------------*
FORM update_bom_status  USING v_matnr TYPE matnr
                              v_werks TYPE werks_d
                              v_idnrk TYPE idnrk
                              v_stlst TYPE stlst
                              v_ecn TYPE aennr
                              v_posnr TYPE sposn
                              v_datuv TYPE datuv
                              iv_flag TYPE abap_bool.
  BREAK 20002966.
  DATA: gv_flag_warning TYPE c,
        gv_index        TYPE sy-tabix,
        gv_found        TYPE c.

  DATA:gt_stpo TYPE TABLE OF  stpo_api02,
       gs_stpo TYPE stpo_api02,
       gt_stko TYPE TABLE OF  stko_api02,
       gs_stko TYPE stko_api02.

  DATA: gd_stpo TYPE TABLE OF stpo_api03,
        wa_stpo TYPE stpo_api03.

  " 1. OPEN the BOM for reading/modification

  DATA: lv_ext_date(10) TYPE c.


  CALL FUNCTION 'CONVERT_DATE_TO_EXTERNAL'
    EXPORTING
      date_internal            = v_datuv "sy-datum
    IMPORTING
      date_external            = lv_ext_date
    EXCEPTIONS
      date_internal_is_invalid = 1
      OTHERS                   = 2.


  " 2. READ the current BOM components

  CALL FUNCTION 'CSAP_MAT_BOM_READ'
    EXPORTING
      material   = v_matnr
      plant      = v_werks
      bom_usage  = '1'
      valid_from = lv_ext_date
    TABLES
      t_stpo     = gd_stpo
      t_stko     = gt_stko
    EXCEPTIONS
      error      = 1
      OTHERS     = 2.

  IF sy-subrc <> 0.
    MESSAGE 'BOM read failed' TYPE 'E'.
    EXIT.
  ENDIF.

  v_idnrk = |{ v_idnrk ALPHA = OUT }|.
  LOOP AT gd_stpo INTO wa_stpo WHERE component = v_idnrk AND item_categ = 'L' AND item_no = v_posnr.

    DATA: iv_exte_chang(10) TYPE c.
    CALL FUNCTION 'CONVERT_DATE_TO_EXTERNAL'
      EXPORTING
        date_internal            = sy-datum
      IMPORTING
        date_external            = iv_exte_chang
      EXCEPTIONS
        date_internal_is_invalid = 1
        OTHERS                   = 2.


    gv_index = sy-tabix.
*    wa_stpo-change_no = v_ecn.
    wa_stpo-changed_on = iv_exte_chang.
    wa_stpo-changed_by = sy-uname.
    MODIFY gd_stpo  FROM wa_stpo INDEX gv_index.
    gv_found = 'X'.

    EXIT.
  ENDLOOP.

  IF gv_found IS INITIAL.
    MESSAGE 'Component not found in BOM' TYPE 'W'.
    EXIT.
  ENDIF.

  DATA: ws_stko       TYPE stko_api01.

  READ TABLE gt_stko INTO ws_stko INDEX 1.
  IF sy-subrc = 0.
    "--------------------------------------------------------"
    " Approve Status = Current Status -1
    "--------------------------------------------------------"
    IF iv_flag = abap_true  AND ws_stko-bom_status > 1.
      ws_stko-bom_status = ws_stko-bom_status - 1.
    ENDIF.
    "--------------------------------------------------------"
    " Rejcect Status from Current Status + 1
    "--------------------------------------------------------"
    IF iv_flag = abap_false  AND ws_stko-bom_status > 1 AND ws_stko-bom_status < 5.
      ws_stko-bom_status = ws_stko-bom_status + 1.
    ENDIF.

    "--------------------------------------------------------"
    " Rejcect Status from 1 - 5
    "--------------------------------------------------------"
    IF iv_flag = abap_false  AND ws_stko-bom_status = 1.
      ws_stko-bom_status = ws_stko-bom_status + 4.
    ENDIF.

    MODIFY gt_stko FROM ws_stko INDEX 1.
  ENDIF.

  "MAINTAIN the BOM with changed components

  AUTHORITY-CHECK OBJECT 'C_STUE_NOH'
           ID 'NOHIS' FIELD 'X'.

  IF sy-subrc <> 0.
    MESSAGE 'You are not authorized to change this BOM without a Change Number' TYPE 'E'.
  ELSE.
    " Perform the BOM update without an ECN
  ENDIF.


  CALL FUNCTION 'CSAP_MAT_BOM_MAINTAIN'
    EXPORTING
      material           = v_matnr
      plant              = v_werks
      bom_usage          = '1'
      valid_from         = lv_ext_date
      change_no          = ''
      i_stko             = ws_stko
      fl_commit_and_wait = 'X'
      fl_bom_create      = space
    TABLES
      t_stpo             = gd_stpo
    EXCEPTIONS
      error              = 1
      OTHERS             = 2.

  IF sy-subrc <> 0.

    DATA: gv_msg TYPE string.

    CALL FUNCTION 'FORMAT_MESSAGE'
      EXPORTING
        id     = sy-msgid
        lang   = sy-langu
        no     = sy-msgno
        v1     = sy-msgv1
        v2     = sy-msgv2
        v3     = sy-msgv3
        v4     = sy-msgv4
      IMPORTING
        msg    = gv_msg
      EXCEPTIONS
        OTHERS = 0.
    MESSAGE gv_msg TYPE 'E'.
    ROLLBACK WORK.
    EXIT.
  ELSE.
    COMMIT WORK.
    MESSAGE 'BOM quantity updated successfully' TYPE 'S'.
  ENDIF.




ENDFORM.
*&---------------------------------------------------------------------*
*& Form USER_STATUS_VALIDATION
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
*&      --> P_STATUS
*&      --> SY_UNAME
*&      <-- LV_FLAG
*&---------------------------------------------------------------------*
FORM user_status_validation  USING iv_status TYPE stlst
                                   iv_uname TYPE sy-uname
                                   iv_plant TYPE werks_d
                             CHANGING iv_flag TYPE abap_bool
                                      cv_message TYPE string
                                      cv_userid TYPE char12.


  CLEAR: cv_message, iv_flag, cv_userid.

  DATA: lv_fieldname TYPE string.

  CASE iv_status.
    WHEN '05'.
      lv_fieldname = 'L1_RND_USERID2'.
    WHEN '04'.
      lv_fieldname = 'L4_PH_USERID'.
    WHEN '03'.
      lv_fieldname = 'L2_PH_USERID'.
    WHEN '02'.
      lv_fieldname = 'L3_PH_USERID'.
    WHEN OTHERS.
      RETURN.
  ENDCASE.

  SELECT SINGLE (lv_fieldname)
    FROM zpp_bom_app
    INTO cv_userid
    WHERE plant = iv_plant.

  IF cv_userid <> iv_uname.
    iv_flag = abap_true.
  ELSE.
    iv_flag = abap_false.
  ENDIF.



ENDFORM.
