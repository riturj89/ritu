*            lv_error_str 'item(s) failed.'
            INTO lv_message SEPARATED BY space.
          MESSAGE lv_message TYPE 'S'.
        ELSE.
          MESSAGE 'No items were updated' TYPE 'S' DISPLAY LIKE 'W'.
        ENDIF.

      ELSE.
        MESSAGE 'Please correct the data before saving' TYPE 'S' DISPLAY LIKE 'E'.
      ENDIF.

      "---Reversal Logic--"
    WHEN 'REJECT'.
      BREAK 20002966.

      " Force ALV to pass UI changes to internal table
      IF lr_grid IS BOUND.
        CALL METHOD lr_grid->check_changed_data
          IMPORTING
            e_valid = lv_valid.
      ENDIF.

      IF lv_valid = abap_true.
        " Process each selected item
        LOOP AT it_out INTO ls_out WHERE sel = 'X'.


          BREAK 20002966.
*          ELSEIF ls_out-stlst = '04' AND ls_out-aennr IS NOT INITIAL.
          IF ls_out-stlst = '04'." AND ls_out-aennr IS NOT INITIAL.

            CLEAR lv_ecn.
